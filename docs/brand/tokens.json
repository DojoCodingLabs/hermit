{
  "$description": "Hermit design tokens. Light = Quiet craft (master). Dark = Deep sea. Contrast ratios are WCAG 2.x against the theme background.",
  "color": {
    "light": {
      "paper":         { "value": "#F5EDE1", "role": "app background" },
      "shell":         { "value": "#EBDDCB", "role": "raised surface, cards, user bubble" },
      "stone":         { "value": "#D3C2AE", "role": "borders, dividers, disabled" },
      "sand":          { "value": "#D5B893", "role": "illustration warmth, highlights; never text" },
      "ink":           { "value": "#2B221B", "role": "primary text, logo", "contrast": 13.42 },
      "ink-soft":      { "value": "#6B5E52", "role": "secondary text", "contrast": 5.40 },
      "seaglass":      { "value": "#4F7C6D", "role": "accent fills, icons, large text only", "contrast": 4.08 },
      "seaglass-deep": { "value": "#3B6456", "role": "links, primary buttons (paper text on it), Hermit bubble", "contrast": 5.75 },
      "coral":         { "value": "#B4483A", "role": "blocked by the cage, destructive", "contrast": 4.60 },
      "amber":         { "value": "#8A5912", "role": "needs approval, caution" }
    },
    "dark": {
      "abyss":   { "value": "#06121D", "role": "app background" },
      "trench":  { "value": "#0D2233", "role": "raised surface, cards" },
      "current": { "value": "#1A4A5E", "role": "borders, user bubble" },
      "kelp":    { "value": "#8FA9B5", "role": "secondary text", "contrast": 7.65 },
      "foam":    { "value": "#E7F1F0", "role": "primary text", "contrast": 16.40 },
      "glow":    { "value": "#5EF0CF", "role": "accent, the shell's inner light; abyss text on it", "contrast": 13.35 },
      "coral":   { "value": "#FF8A7A", "role": "blocked by the cage", "contrast": 8.24 },
      "amber":   { "value": "#F2B65A", "role": "needs approval", "contrast": 10.44 }
    }
  },
  "type": {
    "display": { "family": "Newsreader", "license": "OFL-1.1", "use": "taglines, headlines, long-form; optical sizes 16-72" },
    "ui":      { "family": "Instrument Sans", "license": "OFL-1.1", "use": "interface, body, wordmark base" },
    "mono":    { "family": "JetBrains Mono", "license": "OFL-1.1", "use": "audit hashes, code, the 'read the code' moments" },
    "scale":   [12, 14, 16, 20, 24, 32, 44, 64]
  },
  "radius": { "bubble": 18, "card": 16, "button": 999, "sheet": 28 },
  "space": [4, 8, 12, 16, 24, 32, 48, 64]
}
