{
  "name": "hermit",
  "private": true,
  "description": "Open-source AI agent that lives on your phone. Does everything. Tells no one.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": { "node": ">=24.9 <25" },
  "scripts": {
    "check:privacy": "node scripts/check-privacy.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.mjs scripts/devices/*.test.mjs && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
