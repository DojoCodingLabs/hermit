{
  "about": "SL-35 form field vectors (US-FORM-01, FR-FORM-01), shared by packages/core/test/profile.test.ts and FieldKindTest.kt in apps/mobile/modules/hermit-autofill. 'hintKinds' and 'wordRules' are the shipped tables, which both implementations must equal; 'cases' are fields as Android describes them (autofill hints, HTML attributes with lowercase names, the view's id entry and hint, the raw InputType) and the kind each must get. A null kind means Hermit never fills that field from the profile.",
  "maxFields": 64,
  "hintKinds": {
    "password": "password",
    "currentpassword": "password",
    "newpassword": "password",
    "username": "skip",
    "newusername": "skip",
    "smsotpcode": "skip",
    "onetimecode": "skip",
    "creditcardnumber": "skip",
    "creditcardsecuritycode": "skip",
    "creditcardexpirationdate": "skip",
    "ccnumber": "skip",
    "cccsc": "skip",
    "ccexp": "skip",
    "ccname": "skip",
    "personmiddlename": "skip",
    "additionalname": "skip",
    "organization": "skip",
    "name": "full_name",
    "personname": "full_name",
    "givenname": "given_name",
    "persongivenname": "given_name",
    "familyname": "family_name",
    "personfamilyname": "family_name",
    "email": "email",
    "emailaddress": "email",
    "tel": "phone",
    "phone": "phone",
    "phonenumber": "phone",
    "phonenational": "phone",
    "telnational": "phone",
    "postaladdress": "street_address",
    "streetaddress": "street_address",
    "postaladdressstreetaddress": "street_address",
    "addressline1": "street_address",
    "addressline2": "address_line2",
    "extendedaddress": "address_line2",
    "postaladdressextendedaddress": "address_line2",
    "addresslevel2": "city",
    "addresslocality": "city",
    "postaladdresslocality": "city",
    "addresslevel1": "region",
    "addressregion": "region",
    "postaladdressregion": "region",
    "postalcode": "postal_code",
    "country": "country",
    "countryname": "country",
    "addresscountry": "country",
    "postaladdresscountry": "country",
    "bday": "birth_date",
    "birthdatefull": "birth_date"
  },
  "wordRules": [
    { "kind": "password", "any": ["password", "passwd", "pwd", "contrasena", "clave", "pin"], "all": [] },
    { "kind": "skip", "any": ["username", "usuario", "login", "otp", "captcha", "search", "buscar", "coupon", "cupon", "promo", "company", "empresa", "organization", "card", "tarjeta", "cvv", "cvc"], "all": [] },
    { "kind": "passport_number", "any": ["passport", "pasaporte"], "all": [] },
    { "kind": "tax_id", "any": ["rfc", "nit", "rut", "cuit", "cuil", "ruc", "taxid", "vat", "nif"], "all": [["tax", "id"], ["tax", "number"]] },
    { "kind": "id_number", "any": ["dni", "cedula", "curp", "ssn", "nationalid", "documento", "dui", "identificacion", "identification"], "all": [["national", "id"], ["id", "number"], ["identity", "number"]] },
    { "kind": "email", "any": ["email", "mail", "correo", "emailaddress"], "all": [] },
    { "kind": "phone", "any": ["phone", "tel", "telephone", "telefono", "mobile", "celular", "movil", "cell", "whatsapp"], "all": [] },
    { "kind": "birth_date", "any": ["birthday", "birthdate", "dob", "nacimiento", "cumpleanos"], "all": [["birth", "date"], ["date", "birth"]] },
    { "kind": "postal_code", "any": ["zip", "zipcode", "postal", "postcode", "postalcode", "cp"], "all": [] },
    { "kind": "country", "any": ["country", "pais"], "all": [] },
    { "kind": "region", "any": ["state", "province", "provincia", "region", "estado", "county"], "all": [] },
    { "kind": "city", "any": ["city", "ciudad", "town", "locality", "municipio", "localidad", "canton"], "all": [] },
    { "kind": "address_line2", "any": ["address2", "line2", "apartment", "apt", "suite", "unit", "interior", "depto"], "all": [["address", "2"], ["line", "2"], ["direccion", "2"]] },
    { "kind": "street_address", "any": ["address", "street", "direccion", "calle", "addr", "address1", "line1", "domicilio"], "all": [] },
    { "kind": "full_name", "any": ["fullname", "nombrecompleto"], "all": [["full", "name"], ["nombre", "completo"]] },
    { "kind": "family_name", "any": ["lastname", "surname", "familyname", "apellido", "apellidos", "lname"], "all": [["last", "name"], ["family", "name"]] },
    { "kind": "given_name", "any": ["firstname", "givenname", "fname", "nombre", "nombres"], "all": [["first", "name"], ["given", "name"]] },
    { "kind": "full_name", "any": ["name"], "all": [] }
  ],
  "cases": [
    { "name": "an Android autofill hint wins", "field": { "hints": ["personGivenName"], "html": {}, "idEntry": "field_7", "inputType": 1 }, "expect": "given_name" },
    { "name": "a View constant hint (emailAddress)", "field": { "hints": ["emailAddress"], "html": {}, "inputType": 1 }, "expect": "email" },
    { "name": "a password hint is a password, never a profile field", "field": { "hints": ["password"], "html": {}, "inputType": 129 }, "expect": "password" },
    { "name": "a username hint is skipped", "field": { "hints": ["username"], "html": {}, "idEntry": "email", "inputType": 1 }, "expect": null },
    { "name": "a card number hint is skipped (cards are not in this slice)", "field": { "hints": ["creditCardNumber"], "html": {}, "inputType": 2 }, "expect": null },
    { "name": "HTML autocomplete with a section and a shipping token", "field": { "hints": [], "html": { "autocomplete": "section-a shipping postal-code" }, "inputType": 1 }, "expect": "postal_code" },
    { "name": "HTML autocomplete shipping postal-code", "field": { "hints": [], "html": { "autocomplete": "shipping postal-code" }, "inputType": 1 }, "expect": "postal_code" },
    { "name": "HTML autocomplete tokens split by Unicode whitespace (a no-break space, an ideographic space)", "field": { "hints": [], "html": { "autocomplete": "shipping postal-code" }, "inputType": 1 }, "expect": "postal_code" },
    { "name": "HTML autocomplete with an ideographic space and a tab", "field": { "hints": [], "html": { "autocomplete": "billing　\tcountry-name" }, "inputType": 1 }, "expect": "country" },
    { "name": "HTML autocomplete address-level2 is the city", "field": { "hints": [], "html": { "autocomplete": "address-level2", "name": "x1" }, "inputType": 1 }, "expect": "city" },
    { "name": "HTML autocomplete new-password", "field": { "hints": [], "html": { "autocomplete": "new-password", "name": "nombre" }, "inputType": 1 }, "expect": "password" },
    { "name": "autocomplete off falls through to the words", "field": { "hints": [], "html": { "autocomplete": "off", "name": "telefono" }, "inputType": 1 }, "expect": "phone" },
    { "name": "HTML type email", "field": { "hints": [], "html": { "type": "email", "name": "q1" }, "inputType": 1 }, "expect": "email" },
    { "name": "HTML type tel", "field": { "hints": [], "html": { "type": "tel" }, "inputType": 1 }, "expect": "phone" },
    { "name": "HTML type hidden is never filled", "field": { "hints": [], "html": { "type": "hidden", "name": "email" }, "inputType": 1 }, "expect": null },
    { "name": "HTML type password", "field": { "hints": [], "html": { "type": "password", "name": "dni" }, "inputType": 1 }, "expect": "password" },
    { "name": "a numeric PIN input type is a password", "field": { "hints": [], "html": {}, "idEntry": "code", "inputType": 18 }, "expect": "password" },
    { "name": "a person name input type", "field": { "hints": [], "html": {}, "idEntry": "input1", "inputType": 97 }, "expect": "full_name" },
    { "name": "a postal address input type", "field": { "hints": [], "html": {}, "inputType": 113 }, "expect": "street_address" },
    { "name": "a phone class input type", "field": { "hints": [], "html": {}, "idEntry": "numero", "inputType": 3 }, "expect": "phone" },
    { "name": "camelCase id: firstName", "field": { "hints": [], "html": {}, "idEntry": "firstName", "inputType": 1 }, "expect": "given_name" },
    { "name": "snake_case id: last_name", "field": { "hints": [], "html": { "name": "last_name" }, "inputType": 1 }, "expect": "family_name" },
    { "name": "Spanish label with an accent: Cédula", "field": { "hints": [], "html": { "label": "Número de cédula" }, "inputType": 1 }, "expect": "id_number" },
    { "name": "Spanish: Apellidos", "field": { "hints": [], "html": { "placeholder": "Apellidos" }, "inputType": 1 }, "expect": "family_name" },
    { "name": "Spanish: Nombre completo is the full name, not the given name", "field": { "hints": [], "html": { "aria-label": "Nombre completo" }, "inputType": 1 }, "expect": "full_name" },
    { "name": "Spanish: Nombre alone is the given name", "field": { "hints": [], "html": { "name": "nombre" }, "inputType": 1 }, "expect": "given_name" },
    { "name": "name alone is the full name", "field": { "hints": [], "html": { "name": "name" }, "inputType": 1 }, "expect": "full_name" },
    { "name": "user name words are skipped", "field": { "hints": [], "html": { "name": "username" }, "inputType": 1 }, "expect": null },
    { "name": "company name is skipped, not a person's name", "field": { "hints": [], "html": { "name": "company_name" }, "inputType": 1 }, "expect": null },
    { "name": "email address is the email, not the street", "field": { "hints": [], "html": { "label": "Email address" }, "inputType": 1 }, "expect": "email" },
    { "name": "e-mail with a hyphen", "field": { "hints": [], "html": { "placeholder": "E-mail" }, "inputType": 1 }, "expect": "email" },
    { "name": "address line 2 by its digit", "field": { "hints": [], "html": { "name": "billingAddress2" }, "inputType": 1 }, "expect": "address_line2" },
    { "name": "address line 1", "field": { "hints": [], "html": { "name": "address_line1" }, "inputType": 1 }, "expect": "street_address" },
    { "name": "Dirección", "field": { "hints": [], "hint": "Dirección", "html": {}, "inputType": 1 }, "expect": "street_address" },
    { "name": "Código postal", "field": { "hints": [], "html": { "label": "Código postal" }, "inputType": 1 }, "expect": "postal_code" },
    { "name": "País", "field": { "hints": [], "html": { "name": "pais" }, "inputType": 1 }, "expect": "country" },
    { "name": "Provincia", "field": { "hints": [], "html": { "id": "provincia" }, "inputType": 1 }, "expect": "region" },
    { "name": "Ciudad", "field": { "hints": [], "html": { "id": "ciudad" }, "inputType": 1 }, "expect": "city" },
    { "name": "date of birth", "field": { "hints": [], "html": { "label": "Date of birth" }, "inputType": 1 }, "expect": "birth_date" },
    { "name": "Fecha de nacimiento", "field": { "hints": [], "html": { "label": "Fecha de nacimiento" }, "inputType": 1 }, "expect": "birth_date" },
    { "name": "passport number", "field": { "hints": [], "html": { "name": "passportNumber" }, "inputType": 1 }, "expect": "passport_number" },
    { "name": "RFC (Mexico's tax id)", "field": { "hints": [], "html": { "name": "rfc" }, "inputType": 1 }, "expect": "tax_id" },
    { "name": "tax id words", "field": { "hints": [], "html": { "label": "Tax ID" }, "inputType": 1 }, "expect": "tax_id" },
    { "name": "national id words", "field": { "hints": [], "html": { "label": "National ID" }, "inputType": 1 }, "expect": "id_number" },
    { "name": "a whole-word match only: hotel is not tel", "field": { "hints": [], "html": { "name": "hotel" }, "inputType": 1 }, "expect": null },
    { "name": "a whole-word match only: statement is not state", "field": { "hints": [], "html": { "name": "statement" }, "inputType": 1 }, "expect": null },
    { "name": "Contraseña is a password", "field": { "hints": [], "html": { "label": "Contraseña" }, "inputType": 1 }, "expect": "password" },
    { "name": "nothing to go on", "field": { "hints": [], "html": {}, "inputType": 1 }, "expect": null },
    { "name": "an unknown hint falls through to the words", "field": { "hints": ["off"], "html": { "name": "city" }, "inputType": 1 }, "expect": "city" }
  ]
}
