  "cases": [
    {
      "name": "a web login in Chrome matches its stored https origin",
      "request": {
        "packageName": "com.android.chrome",
        "certDigests": [
          "chromeTestCertDigest_0000000000000000000000"
        ],
        "web": [
          {
            "domain": "accounts.example.com",
            "scheme": "https"
          }
        ]
      },
      "stored": [
        "https://accounts.example.com"
      ],
      "expect": {
        "match": true,
        "origin": "https://accounts.example.com"
      }
    },
    {
      "name": "host case, a trailing dot and the default port are the same origin",
      "request": {
        "packageName": "com.sec.android.app.sbrowser",
        "certDigests": [
          "samsungTestCertDigest_000000000000000000000"
        ],
        "web": [
          {
            "domain": "Accounts.Example.COM.",
            "scheme": "HTTPS"
          }
        ]
      },
      "stored": [
        "https://accounts.example.com:443/"
      ],
      "expect": {
        "match": true,
        "origin": "https://accounts.example.com"
      }
    },
    {
      "name": "a lookalike domain gets nothing",
      "request": {
        "packageName": "com.android.chrome",
        "certDigests": [
          "chromeTestCertDigest_0000000000000000000000"
