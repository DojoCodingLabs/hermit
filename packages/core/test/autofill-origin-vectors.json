        ]
      },
      "index": [
        {
          "ref": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "name": "Bank (Ana)",
          "origins": [
            "https://accounts.example.com"
          ]
        },
        {
          "ref": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "name": "Bank (Luis)",
          "origins": [
            "https://accounts.example.com",
            "android://bankTestCertDigest_000000000000000000000000@com.example.bank"
          ]
        },
        {
          "ref": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
          "name": "Shop",
          "origins": [
            "https://shop.example:8443",
